{
  "name": "@tokenlabai/ai-sdk-provider",
  "version": "0.1.0",
  "description": "TokenLab provider for Vercel AI SDK, built on the OpenAI-compatible provider.",
  "type": "module",
  "license": "MIT",
  "author": "TokenLab",
  "homepage": "https://docs.tokenlab.sh/integrations/vercel-ai-sdk",
  "repository": {
    "type": "git",
